<v:OverlayDialog x:Class="SyncTwoFiles.App.Views.HistoryDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:v="clr-namespace:SyncTwoFiles.App.Views"
                 xmlns:l="clr-namespace:SyncTwoFiles.App">
  <Border Style="{StaticResource DialogCard}" Width="780" Margin="0,24">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock x:Name="Heading" Style="{StaticResource DialogTitle}"/>
      <Grid Grid.Row="1" Margin="0,14,0,10">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid>
          <TextBox x:Name="Query" Style="{StaticResource Field}"/>
          <TextBlock x:Name="QueryHint" Text="{l:T history.search}" Foreground="#636366" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>
        <CheckBox x:Name="ErrorsOnly" Grid.Column="1" Style="{StaticResource Check}" Content="{l:T history.errorsOnly}" Margin="16,0,4,0" VerticalAlignment="Center"/>
      </Grid>
      <Border Grid.Row="2" Style="{StaticResource Card}" Height="400">
        <Grid>
          <TextBox x:Name="Text" IsReadOnly="True" BorderThickness="0" Background="Transparent" CaretBrush="Transparent"
                   SelectionBrush="#0A84FF" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Foreground="#D1D1D6" Padding="12,10"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
          <TextBlock x:Name="Empty" Foreground="{StaticResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Text="{l:T common.loading}" IsHitTestVisible="False"/>
        </Grid>
      </Border>
      <Grid Grid.Row="3" Margin="0,18,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="Reload" Style="{StaticResource Link}" Content="{l:T history.reload}"/>
          <Button x:Name="Notepad" Style="{StaticResource Link}" Content="{l:T history.notepad}"/>
          <TextBlock x:Name="Count" Foreground="#8E8E93" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>
        <Button x:Name="CloseBtn" Grid.Column="1" Style="{StaticResource BtnGray}" Content="{l:T common.close}" Padding="22,8"/>
      </Grid>
    </Grid>
  </Border>
</v:OverlayDialog>
