<v:OverlayDialog x:Class="SyncTwoFiles.App.Views.VersionsDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:v="clr-namespace:SyncTwoFiles.App.Views"
                 xmlns:l="clr-namespace:SyncTwoFiles.App">
  <Border Style="{StaticResource DialogCard}" Width="620" Margin="0,24">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock x:Name="Heading" Style="{StaticResource DialogTitle}"/>
      <TextBlock x:Name="Sub" Grid.Row="1" Style="{StaticResource Hint}" Margin="2,6,0,12"/>
      <Border Grid.Row="2" Style="{StaticResource Card}" MinHeight="120" MaxHeight="380">
        <Grid>
          <TextBlock x:Name="Empty" Foreground="{StaticResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                     TextWrapping="Wrap" TextAlignment="Center" Margin="20" Text="{l:T common.loading}"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Rows" Margin="6">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="10,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource RowIcon}" Background="{Binding Color}">
                      <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}"/>
                      <TextBlock Text="{Binding Detail}" Style="{StaticResource RowSub}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Style="{StaticResource Link}" Content="{l:T common.open}" Tag="{Binding}" Click="OnOpen"/>
                      <Button Style="{StaticResource Link}" Content="{l:T versions.recover}" Tag="{Binding}" Click="OnRecover"/>
                      <Button Style="{StaticResource Link}" Foreground="#FF6961" Content="{l:T common.delete}" Tag="{Binding}" Click="OnDelete"/>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
      <CheckBox x:Name="Replace" Grid.Row="3" Style="{StaticResource Check}" Margin="2,14,0,0">
        <TextBlock Text="{l:T versions.replace}" TextWrapping="Wrap" Foreground="#E5E5EA" MaxWidth="520"/>
      </CheckBox>
      <Grid Grid.Row="4" Margin="0,18,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button x:Name="OpenRoot" Style="{StaticResource Link}" Content="{l:T versions.openRoot}" HorizontalAlignment="Left"/>
        <Button x:Name="CloseBtn" Grid.Column="1" Style="{StaticResource BtnGray}" Content="{l:T common.close}" Padding="22,8"/>
      </Grid>
    </Grid>
  </Border>
</v:OverlayDialog>
