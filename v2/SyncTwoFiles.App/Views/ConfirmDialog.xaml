<v:OverlayDialog x:Class="SyncTwoFiles.App.Views.ConfirmDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:v="clr-namespace:SyncTwoFiles.App.Views"
                 xmlns:l="clr-namespace:SyncTwoFiles.App">
  <Border Style="{StaticResource DialogCard}" Width="400" Padding="24,22">
    <StackPanel>
      <Image x:Name="DlgIcon" Width="52" Height="52" Source="/Assets/SyncTwoFiles.png" RenderOptions.BitmapScalingMode="HighQuality"/>
      <TextBlock x:Name="DlgTitle" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Label}" TextAlignment="Center"
                 TextWrapping="Wrap" Margin="0,12,0,6"/>
      <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="DlgText" FontSize="12" Foreground="{StaticResource Secondary}" TextAlignment="Center" TextWrapping="Wrap"/>
      </ScrollViewer>
      <TextBlock x:Name="DlgInputHint" FontSize="12" Foreground="#AEAEB2" TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,6"/>
      <TextBox x:Name="DlgInput" Style="{StaticResource Field}"/>
      <Grid Margin="0,20,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Button x:Name="DlgCancel" Style="{StaticResource BtnGray}" Content="{l:T common.cancel}" Padding="0,8" IsCancel="True"/>
        <Button x:Name="DlgOk" Grid.Column="2" Style="{StaticResource BtnPrimary}" Padding="0,8"/>
      </Grid>
    </StackPanel>
  </Border>
</v:OverlayDialog>
