<v:OverlayDialog x:Class="SyncTwoFiles.App.Views.WelcomeDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:v="clr-namespace:SyncTwoFiles.App.Views"
                 xmlns:l="clr-namespace:SyncTwoFiles.App">
  <Border Style="{StaticResource DialogCard}" Width="480" Padding="32,28">
    <StackPanel>
      <Grid Height="96">
        <Image x:Name="Logo" Width="88" Height="88" Source="/Assets/SyncTwoFiles.png" RenderOptions.BitmapScalingMode="HighQuality"/>
        <Border x:Name="GlyphBox" Width="76" Height="76" CornerRadius="20" Visibility="Collapsed">
          <TextBlock x:Name="Glyph" Style="{StaticResource Glyph}" FontSize="34"/>
        </Border>
      </Grid>
      <TextBlock x:Name="Title" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="22" FontWeight="Bold"
                 Foreground="{StaticResource Label}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,8"/>
      <TextBlock x:Name="Body" FontSize="13" Foreground="{StaticResource Secondary}" TextAlignment="Center" TextWrapping="Wrap"
                 LineHeight="20" MinHeight="80"/>
      <StackPanel x:Name="Dots" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0"/>
      <Grid Margin="0,22,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Button x:Name="Back" Style="{StaticResource BtnGray}" Content="{l:T welcome.skip}" Padding="0,9"/>
        <Button x:Name="Next" Grid.Column="2" Style="{StaticResource BtnPrimary}" Padding="0,9"/>
      </Grid>
    </StackPanel>
  </Border>
</v:OverlayDialog>
