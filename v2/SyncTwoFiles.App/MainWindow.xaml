<Window x:Class="SyncTwoFiles.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SyncTwoFiles.App"
        Title="Sync two File" Width="1040" Height="800" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Background="#1C1C1E"
        Icon="/Assets/SyncTwoFiles.ico"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                  UseAeroCaptionButtons="False" CornerRadius="0"/>
  </WindowChrome.WindowChrome>

  <Grid x:Name="Root">
    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition/></Grid.RowDefinitions>

    <!-- Barra lateral -->
    <Border Grid.RowSpan="2" Background="#232326" BorderBrush="#2E2E31" BorderThickness="0,0,1,0"/>
    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
      <Image Source="/Assets/SyncTwoFiles.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
      <TextBlock Text="Sync two File" Margin="10,0,0,0" FontSize="12" Foreground="#C7C7CC" VerticalAlignment="Center"/>
    </StackPanel>
    <Grid Grid.Row="1" Margin="12,4,12,12">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="{l:T side.title}" Style="{StaticResource Section}" Margin="8,8,0,8"/>
      <ListBox x:Name="PairList" Grid.Row="1" Style="{StaticResource PlainList}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Ellipse Width="8" Height="8" Fill="{Binding DotBrush}" Margin="2,0,10,0" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#F5F5F7" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="#8E8E93" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
              </StackPanel>
              <TextBlock Grid.Column="2" FontFamily="{StaticResource Icons}" Text="&#xE72E;" FontSize="11" Foreground="#8E8E93"
                         VerticalAlignment="Center" Margin="8,0,2,0" Visibility="{Binding LockVisibility}"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Border x:Name="PausedBanner" Grid.Row="2" Background="#33FF9F0A" CornerRadius="8" Padding="10,8" Margin="0,8,0,0" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
          <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE769;" Foreground="#FF9F0A" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Text="{l:T side.pausedBanner}" Foreground="#FFD60A" FontSize="12" TextWrapping="Wrap" MaxWidth="210"/>
        </StackPanel>
      </Border>
      <Button x:Name="BtnAdd" Grid.Row="3" Style="{StaticResource Btn}" Margin="0,10,0,0" Padding="0,9">
        <StackPanel Orientation="Horizontal">
          <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE710;" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Text="{l:T side.add}"/>
        </StackPanel>
      </Button>
      <Grid Grid.Row="4" Margin="0,10,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button x:Name="BtnPause" Style="{StaticResource IconBtn}" Content="&#xE769;"/>
        <TextBlock x:Name="VersionText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="#636366"/>
        <Button x:Name="BtnSettings" Grid.Column="2" Style="{StaticResource IconBtn}" Content="&#xE713;" ToolTip="{l:T settings.title}"/>
      </Grid>
    </Grid>

    <!-- Botones de ventana -->
    <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
      <Button x:Name="BtnMin" Style="{StaticResource Cap}" Content="&#xE921;" ToolTip="{l:T win.min}"/>
      <Button x:Name="BtnMax" Style="{StaticResource Cap}" Content="&#xE922;" ToolTip="{l:T win.max}"/>
      <Button x:Name="BtnClose" Style="{StaticResource CapClose}" Content="&#xE8BB;" ToolTip="{l:T win.close}"/>
    </StackPanel>

    <!-- Sin sincronizaciones -->
    <StackPanel x:Name="EmptyView" Grid.Column="1" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                MaxWidth="420" Margin="0,0,0,60" Visibility="Collapsed">
      <Image Source="/Assets/SyncTwoFiles.png" Width="96" Height="96" RenderOptions.BitmapScalingMode="HighQuality"/>
      <TextBlock Text="{l:T empty.title}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Label}"
                 HorizontalAlignment="Center" Margin="0,18,0,8"/>
      <TextBlock Text="{l:T empty.text}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource Secondary}" LineHeight="19"/>
      <Button x:Name="BtnAddEmpty" Style="{StaticResource BtnPrimary}" Content="{l:T empty.create}" HorizontalAlignment="Center"
              Margin="0,22,0,0" Padding="22,9"/>
    </StackPanel>

    <!-- Detalle -->
    <Grid x:Name="DetailView" Grid.Column="1" Grid.Row="1">
      <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,4,32,0" MaxWidth="900">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Image Source="/Assets/SyncTwoFiles.png" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
              <TextBlock x:Name="PairName" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="24" FontWeight="Bold"
                         Foreground="{StaticResource Label}" TextTrimming="CharacterEllipsis"/>
              <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                <TextBlock x:Name="LockBadge" FontFamily="{StaticResource Icons}" Text="&#xE72E;" FontSize="11" Foreground="#FF9F0A"
                           VerticalAlignment="Center" Margin="0,1,6,0"/>
                <TextBlock x:Name="PairSub" FontSize="12.5" Foreground="{StaticResource Secondary}"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="BtnEdit" Style="{StaticResource Btn}" Content="{l:T detail.edit}" Margin="0,0,8,0"/>
              <Button x:Name="BtnLock" Style="{StaticResource Btn}"/>
              <Button x:Name="BtnDelete" Style="{StaticResource BtnDanger}" Content="{l:T common.delete}" Margin="8,0,0,0"/>
            </StackPanel>
          </Grid>

          <TextBlock Text="{l:T detail.folders}" Style="{StaticResource Section}"/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid Margin="16,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource RowIcon}" Background="#0A84FF"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;"/></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{l:T editor.source}" Style="{StaticResource RowTitle}"/>
                  <TextBlock x:Name="SrcPath" Style="{StaticResource RowSub}"/>
                </StackPanel>
                <Button x:Name="BtnOpenSrc" Grid.Column="2" Style="{StaticResource Link}" Content="{l:T common.open}"/>
              </Grid>
              <Border Style="{StaticResource RowSep}"/>
              <Grid Margin="16,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource RowIcon}" Background="#636366"><TextBlock Style="{StaticResource Glyph}" Text="&#xEDA2;"/></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{l:T detail.backup}" Style="{StaticResource RowTitle}"/>
                  <TextBlock x:Name="DstPath" Style="{StaticResource RowSub}"/>
                  <Grid Margin="0,8,0,0" x:Name="DiskRow">
                    <Grid.ColumnDefinitions><ColumnDefinition MaxWidth="260"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ProgressBar x:Name="DiskBar" Style="{StaticResource Bar}" Maximum="1" VerticalAlignment="Center"/>
                    <TextBlock x:Name="DiskText" Grid.Column="1" FontSize="11.5" Foreground="{StaticResource Secondary}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                  </Grid>
                </StackPanel>
                <Button x:Name="BtnOpenDst" Grid.Column="2" Style="{StaticResource Link}" Content="{l:T common.open}" VerticalAlignment="Top" Margin="0,6,0,0"/>
              </Grid>
              <StackPanel x:Name="ExcludesRow">
                <Border Style="{StaticResource RowSep}"/>
                <Grid Margin="16,12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource RowIcon}" Background="#8E8E93"><TextBlock Style="{StaticResource Glyph}" Text="&#xE71C;"/></Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{l:T detail.excluded}" Style="{StaticResource RowTitle}"/>
                    <TextBlock x:Name="ExcludesText" Style="{StaticResource RowSub}"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>

          <TextBlock Text="{l:T detail.status}" Style="{StaticResource Section}"/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid Margin="16,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource RowIcon}" Background="#30D158"><TextBlock Style="{StaticResource Glyph}" Text="&#xE823;"/></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{l:T detail.lastCopy}" Style="{StaticResource RowTitle}"/>
                  <TextBlock x:Name="LastCopyText" Style="{StaticResource RowSub}"/>
                </StackPanel>
              </Grid>
              <Border Style="{StaticResource RowSep}"/>
              <Grid Margin="16,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border x:Name="CompareIcon" Style="{StaticResource RowIcon}" Background="#636366"><TextBlock x:Name="CompareGlyph" Style="{StaticResource Glyph}" Text="&#xE9D2;"/></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock x:Name="CompareTitle" Style="{StaticResource RowTitle}"/>
                  <TextBlock x:Name="CompareText" Style="{StaticResource RowSub}" TextWrapping="Wrap" TextTrimming="None"/>
                </StackPanel>
                <Button x:Name="BtnVerify" Grid.Column="2" Style="{StaticResource Btn}" Content="{l:T detail.verify}" VerticalAlignment="Center" MinWidth="110"/>
              </Grid>
            </StackPanel>
          </Border>

          <TextBlock Text="{l:T detail.sync}" Style="{StaticResource Section}"/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid Margin="16,13">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource RowIcon}" Background="#30D158"><TextBlock Style="{StaticResource Glyph}" Text="&#xE895;"/></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{l:T sync.auto}" Style="{StaticResource RowTitle}"/>
                  <TextBlock x:Name="AutoStatus" Style="{StaticResource RowSub}"/>
                </StackPanel>
                <ToggleButton x:Name="AutoSwitch" Grid.Column="2" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
              </Grid>
              <Border Style="{StaticResource RowSep}"/>
              <Grid Margin="16,13">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource RowIcon}" Background="#FF9F0A"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;"/></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{l:T sync.mirror}" Style="{StaticResource RowTitle}"/>
                  <TextBlock Text="{l:T sync.mirrorSub}" Style="{StaticResource RowSub}"/>
                </StackPanel>
                <Button x:Name="BtnMirror" Grid.Column="2" Style="{StaticResource Btn}" Content="{l:T sync.mirrorBtn}" VerticalAlignment="Center" MinWidth="110"/>
              </Grid>
              <Border Style="{StaticResource RowSep}"/>
              <Grid Margin="16,13">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource RowIcon}" Background="#5E5CE6"><TextBlock Style="{StaticResource Glyph}" Text="&#xE777;"/></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{l:T sync.restore}" Style="{StaticResource RowTitle}"/>
                  <TextBlock Text="{l:T sync.restoreSub}" Style="{StaticResource RowSub}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button x:Name="BtnRestoreItem" Style="{StaticResource Btn}" Content="{l:T sync.restoreItemBtn}" Margin="0,0,8,0"/>
                  <Button x:Name="BtnRestore" Style="{StaticResource Btn}" Content="{l:T sync.restoreBtn}" MinWidth="110"/>
                </StackPanel>
              </Grid>
              <Border Style="{StaticResource RowSep}"/>
              <Grid Margin="16,13">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource RowIcon}" Background="#BF5AF2"><TextBlock Style="{StaticResource Glyph}" Text="&#xE81C;"/></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{l:T sync.versions}" Style="{StaticResource RowTitle}"/>
                  <TextBlock x:Name="VersionsSub" Style="{StaticResource RowSub}"/>
                </StackPanel>
                <Button x:Name="BtnVersions" Grid.Column="2" Style="{StaticResource Btn}" Content="{l:T sync.versionsBtn}" VerticalAlignment="Center" MinWidth="110"/>
              </Grid>
            </StackPanel>
          </Border>
          <Grid Height="14"/>
        </StackPanel>
      </ScrollViewer>

      <Grid Grid.Row="1" Margin="32,0,32,20" MaxWidth="900">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="130"/></Grid.RowDefinitions>
        <TextBlock Text="{l:T detail.activity}" Style="{StaticResource Section}" Margin="14,10,0,7"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,5">
          <Button x:Name="BtnLog" Style="{StaticResource Link}" Content="{l:T detail.history}" FontSize="12"/>
          <Button x:Name="BtnClear" Style="{StaticResource Link}" Content="{l:T detail.clear}" FontSize="12"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" ClipToBounds="True">
          <Grid>
            <Border x:Name="BarTrack" Height="3" VerticalAlignment="Top" ClipToBounds="True" Visibility="Hidden" Margin="12,0">
              <Border x:Name="BarFill" Width="140" Background="#0A84FF" CornerRadius="1.5" HorizontalAlignment="Left">
                <Border.RenderTransform><TranslateTransform x:Name="BarShift"/></Border.RenderTransform>
              </Border>
            </Border>
            <TextBox x:Name="Out" IsReadOnly="True" BorderThickness="0" Background="Transparent" CaretBrush="Transparent"
                     SelectionBrush="#0A84FF" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Foreground="#D1D1D6" Padding="12,10"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" TextWrapping="Wrap"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- Dialogos -->
    <Grid x:Name="OverlayHost" Grid.RowSpan="2" Grid.ColumnSpan="2"/>
  </Grid>
</Window>
